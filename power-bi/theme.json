{
  "name": "Clarivens Enterprise Black & Orange",
  "dataColors": [
    "#FF6A00",
    "#FF7A00",
    "#FF8A1F",
    "#FFB067",
    "#E4E4E7",
    "#A1A1AA",
    "#71717A",
    "#52525B",
    "#3F3F46",
    "#27272A"
  ],
  "background": "#050505",
  "foreground": "#111114",
  "tableAccent": "#FF6A00",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#111114" } },
            "transparency": 10
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#27272A" } },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": { "solid": { "color": "#000000" } },
            "position": "Outer",
            "preset": "BottomRight"
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "fontSize": 12,
            "fontFamily": "Segoe UI",
            "bold": true,
            "alignment": "Left"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#050505" } },
            "transparency": 0
          }
        ]
      }
    }
  }
}
