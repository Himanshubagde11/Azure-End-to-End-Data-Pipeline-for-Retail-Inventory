{
  "name": "PL_Load_REST_API",
  "properties": {
    "description": "Ingests REST API live supplier replenishment recommendations and vendor risk scores into stg.RestApi_ProductEnrichment",
    "activities": [
      {
        "name": "Truncate_Staging_REST",
        "type": "SqlServerStoredProcedure",
        "dependsOn": [],
        "policy": { "timeout": "0.00:05:00", "retry": 2, "retryIntervalInSeconds": 30 },
        "typeProperties": {
          "storedProcedureName": "sp_executesql",
          "storedProcedureParameters": {
            "stmt": { "value": "TRUNCATE TABLE stg.RestApi_ProductEnrichment;", "type": "String" }
          }
        },
        "linkedServiceName": { "referenceName": "LS_AzureSqlDatabase_DW", "type": "LinkedServiceReference" }
      },
      {
        "name": "Copy_REST_Catalog_To_Staging",
        "type": "Copy",
        "dependsOn": [
          { "activity": "Truncate_Staging_REST", "dependencyConditions": ["Succeeded"] }
        ],
        "policy": { "timeout": "0.00:15:00", "retry": 3, "retryIntervalInSeconds": 30 },
        "typeProperties": {
          "source": {
            "type": "RestSource",
            "httpRequestTimeout": "00:01:40",
            "requestInterval": "00.00:00:01",
            "paginationRules": {
              "AbsoluteUrl": "$.metadata.nextPageUrl"
            }
          },
          "sink": {
            "type": "AzureSqlSink",
            "writeBehavior": "insert"
          },
          "translator": {
            "type": "TabularTranslator",
            "mappings": [
              { "source": { "path": "['ProductID']" }, "sink": { "name": "ProductID" } },
              { "source": { "path": "['SupplierID']" }, "sink": { "name": "SupplierID" } },
              { "source": { "path": "['LiveReplenishmentPrice']" }, "sink": { "name": "LiveReplenishmentPrice" } },
              { "source": { "path": "['RecommendedSafetyStock']" }, "sink": { "name": "RecommendedSafetyStock" } },
              { "source": { "path": "['VendorLeadTimeDays']" }, "sink": { "name": "VendorLeadTimeDays" } },
              { "source": { "path": "['SupplyChainRiskScore']" }, "sink": { "name": "SupplyChainRiskScore" } },
              { "source": { "path": "['LastEvaluatedDate']" }, "sink": { "name": "LastEvaluatedDate" } }
            ],
            "collectionReference": "$['data']"
          }
        },
        "inputs": [
          {
            "referenceName": "DS_REST_SupplierEnrichment",
            "type": "DatasetReference",
            "parameters": {
              "p_RelativeUrl": "/api/v1/products/enrichment",
              "p_Page": 1,
              "p_Limit": 100
            }
          }
        ],
        "outputs": [
          {
            "referenceName": "DS_SQL_Generic",
            "type": "DatasetReference",
            "parameters": {
              "p_SchemaName": "stg",
              "p_TableName": "RestApi_ProductEnrichment"
            }
          }
        ]
      }
    ],
    "parameters": {
      "p_RunID": { "type": "string", "defaultValue": "MANUAL_RUN" }
    },
    "annotations": ["Clarivens", "REST", "Replenishment"]
  }
}
