{
  "name": "PL_Load_Returns",
  "properties": {
    "description": "Ingests returns into stg.Returns",
    "activities": [
      {
        "name": "Truncate_Staging_Returns",
        "type": "SqlServerStoredProcedure",
        "dependsOn": [],
        "policy": { "timeout": "0.00:05:00", "retry": 2, "retryIntervalInSeconds": 30 },
        "typeProperties": {
          "storedProcedureName": "sp_executesql",
          "storedProcedureParameters": {
            "stmt": { "value": "TRUNCATE TABLE stg.Returns;", "type": "String" }
          }
        },
        "linkedServiceName": { "referenceName": "LS_AzureSqlDatabase_DW", "type": "LinkedServiceReference" }
      },
      {
        "name": "Copy_Returns_To_Staging",
        "type": "Copy",
        "dependsOn": [
          { "activity": "Truncate_Staging_Returns", "dependencyConditions": ["Succeeded"] }
        ],
        "policy": { "timeout": "0.00:15:00", "retry": 3, "retryIntervalInSeconds": 30 },
        "typeProperties": {
          "source": {
            "type": "DelimitedTextSource",
            "storeSettings": { "type": "AzureBlobFSReadSettings", "recursive": false }
          },
          "sink": { "type": "AzureSqlSink", "writeBehavior": "insert" }
        },
        "inputs": [
          {
            "referenceName": "DS_CSV_Generic",
            "type": "DatasetReference",
            "parameters": {
              "p_Container": "raw-data",
              "p_FolderPath": "returns",
              "p_FileName": "returns.csv",
              "p_Delimiter": ","
            }
          }
        ],
        "outputs": [
          {
            "referenceName": "DS_SQL_Generic",
            "type": "DatasetReference",
            "parameters": {
              "p_SchemaName": "stg",
              "p_TableName": "Returns"
            }
          }
        ]
      }
    ],
    "parameters": {
      "p_RunID": { "type": "string", "defaultValue": "MANUAL_RUN" }
    },
    "annotations": ["Clarivens", "Ingestion", "Returns"]
  }
}
