{
  "name": "PL_Load_Stores",
  "properties": {
    "description": "Ingests stores.csv from data lake raw storage into stg.Stores",
    "activities": [
      {
        "name": "Truncate_Staging_Stores",
        "type": "SqlServerStoredProcedure",
        "dependsOn": [],
        "policy": { "timeout": "0.00:05:00", "retry": 2, "retryIntervalInSeconds": 30 },
        "typeProperties": {
          "storedProcedureName": "sp_executesql",
          "storedProcedureParameters": {
            "stmt": { "value": "TRUNCATE TABLE stg.Stores;", "type": "String" }
          }
        },
        "linkedServiceName": { "referenceName": "LS_AzureSqlDatabase_DW", "type": "LinkedServiceReference" }
      },
      {
        "name": "Copy_Stores_CSV_to_Staging",
        "type": "Copy",
        "dependsOn": [
          { "activity": "Truncate_Staging_Stores", "dependencyConditions": ["Succeeded"] }
        ],
        "policy": { "timeout": "0.00:15:00", "retry": 3, "retryIntervalInSeconds": 30 },
        "typeProperties": {
          "source": {
            "type": "DelimitedTextSource",
            "storeSettings": { "type": "AzureBlobFSReadSettings", "recursive": false }
          },
          "sink": {
            "type": "AzureSqlSink",
            "writeBehavior": "insert"
          }
        },
        "inputs": [
          {
            "referenceName": "DS_CSV_Generic",
            "type": "DatasetReference",
            "parameters": {
              "p_Container": "raw-data",
              "p_FolderPath": "",
              "p_FileName": "stores.csv",
              "p_Delimiter": ","
            }
          }
        ],
        "outputs": [
          {
            "referenceName": "DS_SQL_Generic",
            "type": "DatasetReference",
            "parameters": {
              "p_SchemaName": "stg",
              "p_TableName": "Stores"
            }
          }
        ]
      }
    ],
    "parameters": {
      "p_RunID": { "type": "string", "defaultValue": "MANUAL_RUN" }
    },
    "annotations": ["Nexora", "Ingestion", "Stores"]
  }
}
