{
  "name": "LS_AzureBlobStorage_DataLake",
  "type": "Microsoft.DataFactory/factories/linkedservices",
  "properties": {
    "description": "Azure Blob Storage / ADLS Gen2 Linked Service for Clarivens Retail Ingestion Lake",
    "annotations": [
      "Clarivens",
      "Production",
      "Storage"
    ],
    "parameters": {
      "StorageAccountUri": {
        "type": "string",
        "defaultValue": "https://saclarivensdatalakeprod.dfs.core.windows.net"
      }
    },
    "type": "AzureBlobFS",
    "typeProperties": {
      "url": "@linkedService().StorageAccountUri",
      "encryptedCredential": "[PLACEHOLDER_CREDENTIAL_AUTHENTICATED_VIA_MANAGED_IDENTITY]"
    }
  }
}
