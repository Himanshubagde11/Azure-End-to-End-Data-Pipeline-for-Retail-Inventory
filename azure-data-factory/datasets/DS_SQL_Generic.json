{
  "name": "DS_SQL_Generic",
  "type": "Microsoft.DataFactory/factories/datasets",
  "properties": {
    "description": "Generic parameterized Azure SQL Database dataset supporting dynamic schema and table sinks",
    "linkedServiceName": {
      "referenceName": "LS_AzureSqlDatabase_DW",
      "type": "LinkedServiceReference"
    },
    "parameters": {
      "p_SchemaName": {
        "type": "string",
        "defaultValue": "stg"
      },
      "p_TableName": {
        "type": "string",
        "defaultValue": "Sales"
      }
    },
    "annotations": [
      "Nexora",
      "Generic",
      "AzureSQL"
    ],
    "type": "AzureSqlTable",
    "schema": [],
    "typeProperties": {
      "schema": "@dataset().p_SchemaName",
      "table": "@dataset().p_TableName"
    }
  }
}
